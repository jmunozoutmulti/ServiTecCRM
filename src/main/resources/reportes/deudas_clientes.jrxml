<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="deudas_clientes" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30" whenNoDataType="NoDataSection">
	<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9">
		<box leftPadding="4" rightPadding="4"/>
	</style>
	<parameter name="EMPRESA" class="java.lang.String"/>
	<parameter name="USUARIO" class="java.lang.String"/>
	<parameter name="FECHA" class="java.lang.String"/>
	<parameter name="TOTAL_DEUDA" class="java.math.BigDecimal"/>
	<field name="numeroDocumento" class="java.lang.String"/>
	<field name="razonSocial" class="java.lang.String"/>
	<field name="telefono" class="java.lang.String"/>
	<field name="cuotasPendientes" class="java.lang.Long"/>
	<field name="montoPendiente" class="java.math.BigDecimal"/>
	<field name="proximoVencimiento" class="java.lang.String"/>
	<title>
		<band height="70">
			<textField>
				<reportElement x="0" y="0" width="535" height="22" forecolor="#1F3864"/>
				<textElement textAlignment="Center">
					<font size="15" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{EMPRESA}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="24" width="535" height="18"/>
				<textElement textAlignment="Center">
					<font size="12" isBold="true"/>
				</textElement>
				<text><![CDATA[Reporte de deudas pendientes por cliente]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="48" width="300" height="14"/>
				<textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="335" y="48" width="200" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Fecha: " + $P{FECHA}]]></textFieldExpression>
			</textField>
		</band>
	</title>
	<columnHeader>
		<band height="22">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="80" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Documento]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="80" y="0" width="185" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Cliente]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="265" y="0" width="70" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Teléfono]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="335" y="0" width="55" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Cuotas]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="390" y="0" width="70" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Próx. venc.]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="460" y="0" width="75" height="22" forecolor="#FFFFFF" backcolor="#1F3864"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Deuda S/]]></text>
			</staticText>
		</band>
	</columnHeader>
	<detail>
		<band height="20">
			<textField>
				<reportElement x="0" y="0" width="80" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{numeroDocumento}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="80" y="0" width="185" height="20"/>
				<textElement verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{razonSocial}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="265" y="0" width="70" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{telefono}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="335" y="0" width="55" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{cuotasPendientes}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="390" y="0" width="70" height="20"/>
				<textElement textAlignment="Center" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{proximoVencimiento}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00">
				<reportElement x="460" y="0" width="75" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"/>
				<textFieldExpression><![CDATA[$F{montoPendiente}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="19" width="535" height="1" forecolor="#D9D9D9"/>
			</line>
		</band>
	</detail>
	<pageFooter>
		<band height="20">
			<textField>
				<reportElement x="435" y="4" width="100" height="14"/>
				<textElement textAlignment="Right"/>
				<textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>
	<summary>
		<band height="40">
			<textField>
				<reportElement x="0" y="10" width="300" height="20"/>
				<textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA["Clientes con deuda: " + $V{REPORT_COUNT}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="335" y="10" width="125" height="20"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<text><![CDATA[Total por cobrar S/]]></text>
			</staticText>
			<textField pattern="#,##0.00">
				<reportElement mode="Opaque" x="460" y="10" width="75" height="20" backcolor="#DDEBF7"/>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$P{TOTAL_DEUDA}]]></textFieldExpression>
			</textField>
		</band>
	</summary>
	<noData>
		<band height="30">
			<staticText>
				<reportElement x="0" y="5" width="535" height="20"/>
				<textElement textAlignment="Center"/>
				<text><![CDATA[No existen deudas pendientes]]></text>
			</staticText>
		</band>
	</noData>
</jasperReport>
